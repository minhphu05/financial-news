# =============================================================================
# ViFinNER frontend environment template.
# Copy to `.env` (or `.env.local`) and adjust if needed.
# =============================================================================

# Base URL of the FastAPI backend. Leave empty to use the Vite dev proxy
# (`/api` -> http://localhost:8000) during development.
VITE_API_BASE_URL=

# When running outside the Vite dev proxy (e.g. preview / production),
# the API target used by the proxy is configured here.
VITE_API_PROXY=http://localhost:8000
