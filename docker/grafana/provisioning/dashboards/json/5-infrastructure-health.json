{
  "title": "5 - Infrastructure Health",
  "uid": "infrastructure-health",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Running Containers",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "count(container_last_seen{name=~\".+\"})",
        "legendFormat": "Containers",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Host CPU Usage",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.7, "color": "yellow" }, { "value": 0.9, "color": "red" }] } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
        "legendFormat": "CPU",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Host Memory Usage",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.7, "color": "yellow" }, { "value": 0.9, "color": "red" }] } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
        "legendFormat": "Memory",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Disk Usage",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.75, "color": "yellow" }, { "value": 0.9, "color": "red" }] } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
        "legendFormat": "Disk",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "none" } } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "container_memory_usage_bytes{name=~\".+\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Container Network I/O",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}} RX",
        "refId": "A"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}} TX",
        "refId": "B"
      }]
    },
    {
      "type": "timeseries",
      "title": "Container Disk I/O",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}} Read",
        "refId": "A"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}} Write",
        "refId": "B"
      }]
    },
    {
      "type": "table",
      "title": "Container Status Overview",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Memory", "desc": true }] },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [{ "matcher": { "id": "byName", "options": "CPU" }, "properties": [{ "id": "unit", "value": "percentunit" }] }, { "matcher": { "id": "byName", "options": "Memory" }, "properties": [{ "id": "unit", "value": "decbytes" }] }] },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m]))",
        "legendFormat": "{{name}}",
        "refId": "A",
        "format": "table",
        "instant": true
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus-main" },
        "expr": "container_memory_usage_bytes{name=~\".+\"}",
        "legendFormat": "{{name}}",
        "refId": "B",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true, "image": true } } }
      ]
    }
  ]
}
