# Avoid copying heavy datasets and notebooks into the build context.
data/
**/__pycache__/
*.pyc
.git/
.gitignore
.venv/
venv/
env/
.env
.env.*
!.env.example
**/*.ipynb
**/*.ipynb_checkpoints
docs/
notebooks/
*.log
.pytest_cache/
# Runtime evidence and credentials must never become image layers.
artifacts/
logs/
secrets/
.secrets/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.dump
**/*.backup
