# =====================================================================
# Financial News RAG Stack - Environment Configuration Example
# =====================================================================
# 
# This file documents all environment variables required by the stack.
# Copy this file to .env and fill in your actual values.
# 
# DO NOT commit the actual .env file to version control!
# This file (.env.example) should be committed instead.
# 
# =====================================================================

# =====================================================================
# GENERAL CONFIGURATION
# =====================================================================

# Application environment: development, staging, or production
APP_ENV=development

# Application name for logging and identification
APP_NAME=financial-news-rag

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# =====================================================================
# MONGODB CONFIGURATION
# =====================================================================
# Primary document database for storing raw and cleaned articles

# MongoDB root username (admin user)
MONGO_USER=admin

# MongoDB root password - CHANGE IN PRODUCTION!
MONGO_PASSWORD=admin

# MongoDB connection port
MONGO_PORT=27017

# MongoDB database name for raw articles
MONGO_DB_RAW=financial_news_raw

# MongoDB database name for processed articles
MONGO_DB_PROCESSED=financial_news_processed


# =====================================================================
# POSTGRESQL - PREFECT CONFIGURATION
# =====================================================================
# PostgreSQL database used by Prefect for orchestration metadata

# PostgreSQL username for Prefect
PF_POSTGRES_USER=prefect

# PostgreSQL password for Prefect - CHANGE IN PRODUCTION!
PF_POSTGRES_PASSWORD=prefect

# PostgreSQL database name for Prefect
PF_POSTGRES_DB=prefectdb

# PostgreSQL port (internal container port)
PF_POSTGRES_INTERNAL_PORT=5432

# PostgreSQL port (external/host port)
PF_POSTGRES_EXTERNAL_PORT=5432

# PostgreSQL host name within Docker network
PF_POSTGRES_HOST=posgresql-prefect


# =====================================================================
# POSTGRESQL - METADATA STORAGE CONFIGURATION
# =====================================================================
# PostgreSQL 17 database for storing application metadata and processed data

# PostgreSQL metadata database username
METADATA_POSTGRES_USER=metadata_user

# PostgreSQL metadata database password - CHANGE IN PRODUCTION!
METADATA_POSTGRES_PASSWORD=metadata_password

# PostgreSQL metadata database name
METADATA_POSTGRES_DB=financial_metadata

# PostgreSQL metadata database port (internal container port)
METADATA_POSTGRES_INTERNAL_PORT=5432

# PostgreSQL metadata database port (external/host port)
METADATA_POSTGRES_EXTERNAL_PORT=5434

# PostgreSQL metadata host name within Docker network
METADATA_POSTGRES_HOST=postgresql

# PostgreSQL metadata host as seen from the *host* machine (CLI / local Python).
# Set this to the IP/hostname reachable from outside the Docker network.
METADATA_POSTGRES_HOST_EXTERNAL=localhost

# PostgreSQL version
METADATA_POSTGRES_VERSION=17

# PostgreSQL memory limit in MB
METADATA_POSTGRES_MEMORY=256

# PostgreSQL shared buffer size (typically 25% of available RAM)
METADATA_POSTGRES_SHARED_BUFFERS=64MB

# PostgreSQL effective cache size
METADATA_POSTGRES_EFFECTIVE_CACHE_SIZE=256MB

# PostgreSQL work memory per operation (in MB)
METADATA_POSTGRES_WORK_MEM=4MB

# PostgreSQL maintenance work memory (in MB)
METADATA_POSTGRES_MAINTENANCE_WORK_MEM=64MB

# Database max connections
METADATA_POSTGRES_MAX_CONNECTIONS=100


# =====================================================================
# REDIS CONFIGURATION
# =====================================================================
# Redis for caching and message brokering in Prefect

# Redis host name within Docker network
REDIS_HOST=redis-prefect

# Redis port
REDIS_PORT=6379

# Redis database number for messaging
REDIS_MESSAGING_DB=0

# Redis database number for caching
REDIS_CACHE_DB=1

# Redis password (optional, empty by default)
REDIS_PASSWORD=


# =====================================================================
# MLFLOW CONFIGURATION
# =====================================================================
# MLflow tracking server for experiment management and model registry

# MLflow server host
MLFLOW_HOST=mlflow

# MLflow server port (external host port; internal container still uses 5000)
# Set to 5555 to avoid conflicts with other applications
MLFLOW_PORT=5555

# MLflow artifact storage location
MLFLOW_ARTIFACT_PATH=/mlflow/artifacts

# MLflow backend store location
MLFLOW_BACKEND_STORE=/mlflow/store

# MLflow tracking URI (internal Docker network reference)
MLFLOW_TRACKING_URI=http://mlflow:5000


# =====================================================================
# PREFECT CONFIGURATION
# =====================================================================
# Prefect workflow orchestration platform

# Prefect server host
PREFECT_SERVER_HOST=prefect-server

# Prefect server port
PREFECT_SERVER_PORT=4200

# Prefect API URL for workers to connect
PREFECT_API_URL=http://prefect-server:4200/api

# Prefect database connection pool size
PREFECT_SQLALCHEMY_POOL_SIZE=20

# Prefect async pool size
PREFECT_SQLALCHEMY_MAX_OVERFLOW=10

# Prefect flow runs retention (in days)
PREFECT_RUNS_RETENTION_DAYS=30

# Prefect logging level
PREFECT_LOGGING_LEVEL=INFO


# =====================================================================
# DATA INGESTION CONFIGURATION
# =====================================================================
# Configuration for scraping and ingestion workflows

# Scraper request timeout (in seconds)
SCRAPER_TIMEOUT=30

# Scraper maximum retries
SCRAPER_MAX_RETRIES=3

# Scraper delay between requests (in seconds)
SCRAPER_DELAY=1

# Batch size for ingestion operations
INGESTION_BATCH_SIZE=100

# Number of worker threads for parallel ingestion
INGESTION_WORKERS=4

# Logging directory for ingestion processes
INGESTION_LOG_DIR=./logs/ingestion


# =====================================================================
# SCRAPER (multi-source) CONFIGURATION
# =====================================================================
# Crawl behaviour (shared by every source)
SCRAPER_START_PAGE=1
SCRAPER_MAX_PAGES=200
# Stop a keyword crawl after this many consecutive already-seen articles.
SCRAPER_CONSECUTIVE_KNOWN_THRESHOLD=100
# Recorded on each crawl_job row.
SCRAPER_VERSION=2.0.0

# HTTP client tuning (shared)
SCRAPER_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SCRAPER_REQUEST_DELAY_MIN=0.5
SCRAPER_REQUEST_DELAY_MAX=1.5

# Directory where per-run log files are persisted
LOGS_DIR=./logs/scraper

# --- Per-source overrides (optional) ---------------------------------
# Each parser ships sensible defaults; override the URL conventions here.
CAFEF_BASE_URL=https://cafef.vn
CAFEF_SEARCH_URL_TEMPLATE=https://cafef.vn/tim-kiem/trang-{page}.chn?keywords={keyword}


# =====================================================================
# ADLS (Azure Data Lake Storage Gen2) — raw article content
# =====================================================================
# Storage backend for scraper article JSON/images.
# Production/default: adls. Local-only test option: minio.
CONTENT_STORAGE_BACKEND=adls

# Provide EITHER a connection string, OR account name + key.
ADLS_CONNECTION_STRING=
ADLS_ACCOUNT_NAME=
ADLS_ACCOUNT_KEY=
# Filesystem (container) and path prefix for raw JSON blobs.
ADLS_FILESYSTEM=financialnews-datalake
ADLS_ROOT_PREFIX=datascraping


# =====================================================================
# MINIO (local-only temporary ADLS substitute)
# =====================================================================
# Use only for local testing before switching back to ADLS.
# For host Python, endpoint is localhost:9000. Inside Docker worker, compose
# overrides it to minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=financialnews-datalake
MINIO_SECURE=false
MINIO_ROOT_PREFIX=datascraping
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# =====================================================================
# NETWORK CONFIGURATION
# =====================================================================

# Primary Docker network name
DOCKER_NETWORK=financial-net

# MongoDB Docker network name
MONGO_NETWORK=vifinner-net


# =====================================================================
# VOLUME CONFIGURATION
# =====================================================================

# PostgreSQL (Prefect) data volume name
POSTGRES_DATA_VOLUME=postgres_data

# Redis data volume name
REDIS_DATA_VOLUME=redis_data

# MLflow store volume name
MLFLOW_STORE_VOLUME=mlflow_store

# MLflow artifacts volume name
MLFLOW_ARTIFACTS_VOLUME=mlflow_artifacts

# Metadata PostgreSQL data volume name
METADATA_POSTGRES_DATA_VOLUME=metadata_postgres_data


# =====================================================================
# CONTAINER CONFIGURATION
# =====================================================================

# Container restart policy
CONTAINER_RESTART_POLICY=unless-stopped

# Health check interval (in seconds)
HEALTH_CHECK_INTERVAL=10

# Health check timeout (in seconds)
HEALTH_CHECK_TIMEOUT=5

# Health check max retries
HEALTH_CHECK_RETRIES=5

# Health check start period (in seconds)
HEALTH_CHECK_START_PERIOD=10


# =====================================================================
# SECURITY CONFIGURATION
# =====================================================================

# Enable SSL/TLS for PostgreSQL connections (true/false)
POSTGRES_SSL_ENABLED=false

# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
POSTGRES_SSL_MODE=disable

# JWT secret key for API authentication - GENERATE IN PRODUCTION!
JWT_SECRET_KEY=your-secret-key-change-in-production

# API token for authentication
API_TOKEN=your-api-token-change-in-production


# =====================================================================
# MONITORING & OBSERVABILITY
# =====================================================================

# Enable verbose logging for debugging
DEBUG=false

# Enable request/response logging
LOG_REQUESTS=false

# Enable database query logging
LOG_SQL_QUERIES=false

# --- Grafana (Web UI for log exploration) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-in-production
GRAFANA_EXTERNAL_PORT=3000

# --- Loki (Log aggregation backend) ---
LOKI_EXTERNAL_PORT=3100

# --- Prometheus (Metrics storage) ---
PROMETHEUS_ENABLED=true
PROMETHEUS_EXTERNAL_PORT=9090

# --- Pushgateway (Batch job metrics relay) ---
PUSHGATEWAY_EXTERNAL_PORT=9091

# --- Fluent Bit (Log shipper) ---
FLUENT_BIT_METRICS_PORT=2020


# =====================================================================
# INCREMENTAL SCRAPING
# =====================================================================

# Stop crawling a keyword when N consecutive articles already exist in DB.
# Higher values = deeper historical backfill; lower = faster daily runs.
SCRAPER_CONSECUTIVE_KNOWN_THRESHOLD=10
