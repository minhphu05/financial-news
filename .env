# =====================================================================
# Financial News RAG Stack - Local Development Environment
# =====================================================================
# 
# This is the actual environment configuration file.
# DO NOT commit this file to version control - it may contain secrets!
# 
# For production deployments, use a secure secrets management solution
# like Azure Key Vault, AWS Secrets Manager, or HashiCorp Vault.
# 
# =====================================================================

# =====================================================================
# GENERAL CONFIGURATION
# =====================================================================
APP_ENV=development
APP_NAME=financial-news-rag
LOG_LEVEL=INFO


# =====================================================================
# MONGODB CONFIGURATION
# =====================================================================
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_PORT=27017
MONGO_DB_RAW=financial_news_raw
MONGO_DB_PROCESSED=financial_news_processed

# Fully-formed Mongo URI used by the scraper running on the *host* machine.
# When set, this overrides MONGO_USER/PASSWORD/HOST/PORT composition.
# Docker host port is 27018 to avoid clashing with a host-side mongod on 27017.
MONGO_URI=mongodb://admin:admin@localhost:27018/?authSource=admin


# =====================================================================
# POSTGRESQL - PREFECT CONFIGURATION
# =====================================================================
PF_POSTGRES_USER=prefect
PF_POSTGRES_PASSWORD=prefect
PF_POSTGRES_DB=prefectdb
PF_POSTGRES_INTERNAL_PORT=5432
PF_POSTGRES_EXTERNAL_PORT=5435
PF_POSTGRES_HOST=postgresql-prefect


# =====================================================================
# POSTGRESQL - METADATA STORAGE CONFIGURATION
# =====================================================================
METADATA_POSTGRES_USER=metadata_user
METADATA_POSTGRES_PASSWORD=metadata_password
METADATA_POSTGRES_DB=financial_metadata
METADATA_POSTGRES_INTERNAL_PORT=5432
METADATA_POSTGRES_EXTERNAL_PORT=5434
METADATA_POSTGRES_HOST=postgresql
METADATA_POSTGRES_HOST_EXTERNAL=localhost
METADATA_POSTGRES_VERSION=17
METADATA_POSTGRES_MEMORY=256
METADATA_POSTGRES_SHARED_BUFFERS=64MB
METADATA_POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
METADATA_POSTGRES_WORK_MEM=4MB
METADATA_POSTGRES_MAINTENANCE_WORK_MEM=64MB
METADATA_POSTGRES_MAX_CONNECTIONS=100


# =====================================================================
# REDIS CONFIGURATION
# =====================================================================
REDIS_HOST=redis-prefect
REDIS_PORT=6379
REDIS_MESSAGING_DB=0
REDIS_CACHE_DB=1
REDIS_PASSWORD=


# =====================================================================
# MLFLOW CONFIGURATION
# =====================================================================
MLFLOW_HOST=mlflow
# Internal MLflow port (container): 5000
# External host port: 5555 (to avoid conflicts)
MLFLOW_PORT=5555
MLFLOW_ARTIFACT_PATH=/mlflow/artifacts
MLFLOW_BACKEND_STORE=/mlflow/store
# Internal Docker network tracking URI (used by services inside Docker)
MLFLOW_TRACKING_URI=http://mlflow:5000


# =====================================================================
# PREFECT CONFIGURATION
# =====================================================================
PREFECT_SERVER_HOST=prefect-server
PREFECT_SERVER_PORT=4200
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_SQLALCHEMY_POOL_SIZE=20
PREFECT_SQLALCHEMY_MAX_OVERFLOW=10
PREFECT_RUNS_RETENTION_DAYS=30
PREFECT_LOGGING_LEVEL=INFO


# =====================================================================
# DATA INGESTION CONFIGURATION
# =====================================================================
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY=1
INGESTION_BATCH_SIZE=100
INGESTION_WORKERS=4
INGESTION_LOG_DIR=./logs/ingestion


# =====================================================================
# CAFEF SCRAPER CONFIGURATION
# =====================================================================
# Source site
CAFEF_BASE_URL=https://cafef.vn
# Search URL template - {page} and {keyword} are formatted at runtime
CAFEF_SEARCH_URL_TEMPLATE=https://cafef.vn/tim-kiem/trang-{page}.chn?keywords={keyword}

# Pagination bounds
CAFEF_START_PAGE=1
CAFEF_MAX_PAGES=200

# HTTP client tuning
CAFEF_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 13_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
CAFEF_REQUEST_DELAY_MIN=0.5
CAFEF_REQUEST_DELAY_MAX=1.5

# Input/output paths (relative to project root)
RAW_INPUT_DIR=./data/raw
LOGS_DIR=./logs/scraper

# Source identifier persisted with each article
SOURCE_NAME=cafef

# Storage destinations - which DBs hold which payload
# Metadata table name inside METADATA_POSTGRES_DB
METADATA_TABLE_NAME=news_articles
# MongoDB DB + collection for raw article content
MONGO_CONTENT_DB=financial_news
MONGO_CONTENT_COLLECTION=articles_content


# =====================================================================
# NETWORK CONFIGURATION
# =====================================================================
DOCKER_NETWORK=financial-net
MONGO_NETWORK=financial-net


# =====================================================================
# VOLUME CONFIGURATION
# =====================================================================
POSTGRES_DATA_VOLUME=postgres_data
REDIS_DATA_VOLUME=redis_data
MLFLOW_STORE_VOLUME=mlflow_store
MLFLOW_ARTIFACTS_VOLUME=mlflow_artifacts
METADATA_POSTGRES_DATA_VOLUME=metadata_postgres_data


# =====================================================================
# CONTAINER CONFIGURATION
# =====================================================================
CONTAINER_RESTART_POLICY=unless-stopped
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=10


# =====================================================================
# SECURITY CONFIGURATION
# =====================================================================
POSTGRES_SSL_ENABLED=false
POSTGRES_SSL_MODE=disable
JWT_SECRET_KEY=dev-secret-key-not-for-production
API_TOKEN=dev-api-token-not-for-production


# =====================================================================
# MONITORING & OBSERVABILITY
# =====================================================================
DEBUG=false
LOG_REQUESTS=false
LOG_SQL_QUERIES=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_EXTERNAL_PORT=3000

# --- Loki ---
LOKI_EXTERNAL_PORT=3100

# --- Prometheus ---
PROMETHEUS_ENABLED=true
PROMETHEUS_EXTERNAL_PORT=9090

# --- Pushgateway (for batch scraper metrics) ---
PUSHGATEWAY_EXTERNAL_PORT=9091

# --- Fluent Bit ---
FLUENT_BIT_METRICS_PORT=2020


# =====================================================================
# INCREMENTAL SCRAPING
# =====================================================================
# Stop crawling a keyword when N consecutive articles are already in the DB.
# Higher values = deeper historical backfill; lower = faster daily runs.
SCRAPER_CONSECUTIVE_KNOWN_THRESHOLD=100


# =====================================================================
# QDRANT (vector store)
# =====================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_EXTERNAL_PORT=6333
QDRANT_COLLECTION=financial_news_chunks
# QDRANT_API_KEY=         # set if Qdrant runs with API-key auth (cloud / secured)


# =====================================================================
# VOYAGE AI (embeddings)
# =====================================================================
VOYAGE_API_KEY=pa-oiV-HFd9Das7ii5kWes736nW4U3hwU38TKCJ0_2vaaG
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIM=1024
VOYAGE_BATCH_SIZE=128


# =====================================================================
# OPENROUTER (multi-model LLM)
# =====================================================================
OPENROUTER_API_KEY=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
OPENROUTER_DEFAULT_MODEL=liquid/lfm-2.5-1.2b-thinking:free
# OPENROUTER_TEMPERATURE=0.2
# OPENROUTER_MAX_TOKENS=2048
