# Syntax-only migration template. No Azure resource or credential is used in Phase 06.
ENVIRONMENT=cloud
OBJECT_STORAGE_PROVIDER=adls
OBJECT_STORAGE_SCHEME=abfss
AZURE_STORAGE_ACCOUNT=replace-with-storage-account
AZURE_STORAGE_CONTAINER=financial-news
NEWS_SOURCE_FILE=/workspace/input/release-fixture.json
NEWS_SOURCE=local-release.test
NEWS_PROCESSING_VERSION=local-rc1
NEWS_SPARK_MASTER=spark://replace-with-spark-control-plane:7077
NEWS_QDRANT_URL=https://replace-with-qdrant-endpoint
NEWS_QDRANT_COLLECTION=news_chunks_cloud_v1
NEWS_DUCKDB_PATH=/workspace/serving/analytics.duckdb
KAFKA_BOOTSTRAP_SERVERS=replace-with-kafka-bootstrap:9093
DEBEZIUM_CONNECT_URL=https://replace-with-connect-endpoint
METADATA_POSTGRES_HOST=replace-with-postgresql-endpoint
AIRFLOW_API_BASE_URL=https://replace-with-airflow-endpoint
NEWS_SOURCE_INGESTION_ID=profile-validation-only
