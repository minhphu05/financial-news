# Phase 06 local profile. Copy the repository .env.example to .env for Compose;
# this smaller file documents only the financial-news platform boundary.
ENVIRONMENT=local
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_SCHEME=s3a
NEWS_STORAGE_ENDPOINT=http://minio:9000
NEWS_STORAGE_ACCESS_KEY=minioadmin
NEWS_STORAGE_SECRET_KEY=minioadmin
NEWS_STORAGE_BUCKET=financial-news
NEWS_SOURCE_FILE=/app/data/raw/cafef_news_raw_final.json
NEWS_SOURCE=cafef.vn
NEWS_PROCESSING_VERSION=cafef-v1.1
NEWS_SPARK_MASTER=local[2]
NEWS_QDRANT_URL=http://qdrant:6333
NEWS_QDRANT_COLLECTION=news_chunks_local_v1
NEWS_DUCKDB_PATH=/app/local/analytics.duckdb
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DEBEZIUM_CONNECT_URL=http://debezium:8083
METADATA_POSTGRES_HOST=postgresql
AIRFLOW_API_BASE_URL=http://airflow-webserver:8080
NEWS_SOURCE_INGESTION_ID=profile-validation-only
