      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có số liệu",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Lớp|Nguồn|Pipeline|Stage|Loại số liệu|Topic|Partition|Mức độ|Cgroup ID)$"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Bảng snapshot hiện tại: nguồn, stage, loại số liệu, giá trị. input/output/chunk/aggregation là đơn vị khác nhau, không cộng tất cả thành tổng bài.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "source": "Nguồn",
              "pipeline": "Pipeline",
              "stage": "Stage",
              "layer": "Lớp",
              "kind": "Loại số liệu",
              "status": "Trạng thái",
              "topic": "Topic",
              "partition": "Partition",
              "device": "Thiết bị",
              "id": "Cgroup ID",
              "Value": "Giá trị",
              "alertname": "Cảnh báo",
              "severity": "Mức độ"
            }
          }
        }
      ]
    },
