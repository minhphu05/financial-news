  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Cách đọc dashboard này",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Đọc tỷ lệ run hoàn tất và thời gian → stage nào lâu/lỗi → record volumes. Lọc theo pipeline/hostname ở đầu trang. Metrics pipeline là snapshot ledger, có thể gồm fixture cùng hostname; chỉ dashboard Crawling có bộ lọc live/fixture. Không suy ra số bài trong cửa sổ pilot từ số lũy kế. Bộ đếm là ledger toàn lịch sử, không phải số run trong time range.\n\n**Cách dùng:** giờ Việt Nam · mặc định 1 giờ gần nhất · refresh 30 giây. Ô số/bảng lấy snapshot tại cuối khoảng chọn; đồ thị hiển thị diễn biến. `Chưa có số liệu` khác với 0. Đọc tooltip (ⓘ) của từng panel. Đổi dashboard sẽ giữ thời gian và trả bộ lọc về mặc định để tránh nhầm hostname với source key."
      },
      "transparent": false
    },
    {
      "id": 1,
      "title": "Thời gian run hoàn tất gần nhất",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "financial_news_pipeline_last_run_duration_seconds{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\"}",
          "legendFormat": "{{source}} · {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Chưa có số liệu",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Runner started_at → finished_at; không gồm thời gian chờ Airflow. Một đường FAILED cũ có thể tồn tại cạnh SUCCESS mới. Không phải histogram/p95."
    },
    {
      "id": 2,
      "title": "Thời gian attempt stage gần nhất",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
