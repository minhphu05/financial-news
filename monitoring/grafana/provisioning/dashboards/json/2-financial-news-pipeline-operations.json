        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "financial_news_pipeline_stage_duration_seconds{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\"}",
          "legendFormat": "{{source}} · {{stage}} · {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Chưa có số liệu",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Snapshot attempt gần nhất của từng stage, không phải tổng thời gian của mọi stage trong cửa sổ. Chọn một nguồn để xem rõ."
    },
    {
      "id": 3,
      "title": "Run theo trạng thái — lũy kế ledger",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(source,status) (financial_news_pipeline_runs_total{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\"})",
          "legendFormat": "{{source}} · {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có số liệu",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Lũy kế/snapshot từ PostgreSQL, không phải số phát sinh trong khoảng thời gian đang chọn; đổi time range chỉ đổi diễn biến hiển thị. Giữ cả lỗi đã phục hồi, không lấy increase()/rate() như counter đơn điệu."
    },
    {
      "id": 4,
      "title": "Tỷ lệ run hoàn tất SUCCESS — toàn ledger",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(financial_news_pipeline_runs_total{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\",status=\"SUCCESS\"}) or vector(0)) / sum(financial_news_pipeline_runs_total{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\",status=~\"SUCCESS|FAILED\"})) and on() (sum(financial_news_pipeline_runs_total{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\",status=~\"SUCCESS|FAILED\"}) > 0) and on() (financial_news_exporter_collection_success == 1)",
          "legendFormat": "Run SUCCESS / (SUCCESS + FAILED)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Chưa có số liệu",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Loại RUNNING khỏi mẫu số. Không phải success rate riêng pilot hay SLO. Chưa có completed run: không tính 0%/100% giả."
    },
    {
      "id": 5,
      "title": "Record counts của attempt stage gần nhất",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "financial_news_pipeline_records{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\"}",
          "legendFormat": "{{source}} · {{stage}} · {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
