              "layer": "Lớp",
              "kind": "Loại số liệu",
              "status": "Trạng thái",
              "topic": "Topic",
              "partition": "Partition",
              "device": "Thiết bị",
              "id": "Cgroup ID",
              "Value": "Giá trị",
              "alertname": "Cảnh báo",
              "severity": "Mức độ"
            }
          }
        }
      ]
    },
