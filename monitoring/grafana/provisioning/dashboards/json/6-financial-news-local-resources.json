  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Cách đọc dashboard này",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "CPU/RAM/filesystem là máy phát triển dùng chung, không phải riêng pipeline. Network hiện là namespace Docker của node-exporter (eth0), KHÔNG phải toàn bộ NIC host. Cgroup có cả parent/child, không cộng thành tổng RAM container. Không có benchmark hoặc capacity/SLA được suy ra từ các đồ thị này.\n\n**Cách dùng:** giờ Việt Nam · mặc định 1 giờ gần nhất · refresh 30 giây. Ô số/bảng lấy snapshot tại cuối khoảng chọn; đồ thị hiển thị diễn biến. `Chưa có số liệu` khác với 0. Đọc tooltip (ⓘ) của từng panel. Đổi dashboard sẽ giữ thời gian và trả bộ lọc về mặc định để tránh nhầm hostname với source key."
      },
      "transparent": false
    },
    {
      "id": 1,
      "title": "CPU bận — toàn workstation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
          "legendFormat": "CPU toàn máy",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Chưa có số liệu",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Trung bình mọi CPU từ node exporter, gồm ứng dụng khác. Cửa sổ rate 2 phút; không phải CPU riêng Spark."
    },
    {
      "id": 2,
      "title": "RAM sử dụng — toàn workstation",
