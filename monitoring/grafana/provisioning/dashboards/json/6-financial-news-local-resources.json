    {
      "id": 6,
      "title": "Top 15 cgroup RAM — không cộng parent/child",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, container_memory_working_set_bytes)",
          "legendFormat": "{{id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Chưa có số liệu",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Lớp|Nguồn|Pipeline|Stage|Loại số liệu|Topic|Partition|Mức độ|Cgroup ID)$"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "cAdvisor trên máy này chưa có nhãn tên Docker container. Giữ Cgroup ID để nhận diện, gồm root/user.slice và nhóm con chồng lặp; không cộng các hàng.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
