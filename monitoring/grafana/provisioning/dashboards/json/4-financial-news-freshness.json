      "targets": [
        {
          "refId": "A",
          "expr": "financial_news_data_last_success_timestamp_seconds{pipeline=~\"${pipeline:regex}\",source=~\"${news_source:regex}\",layer=~\"${data_layer:regex}\"} * 1000",
          "legendFormat": "{{source}} · {{layer}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
