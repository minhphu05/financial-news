      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có số liệu",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Giá trị"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:DD/MM/YYYY HH:mm:ss"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Lớp|Nguồn|Pipeline|Stage|Loại số liệu|Topic|Partition|Mức độ|Cgroup ID)$"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Epoch giây từ exporter được nhân 1000 cho Date/Time của Grafana. Đây là thời điểm xử lý, không phải published_at của article. Bộ lọc lớp ở đầu trang áp dụng cho biểu đồ/bảng này; mặc định silver để giảm số đường.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "source": "Nguồn",
              "pipeline": "Pipeline",
              "stage": "Stage",
              "layer": "Lớp",
              "kind": "Loại số liệu",
              "status": "Trạng thái",
              "topic": "Topic",
              "partition": "Partition",
              "device": "Thiết bị",
              "id": "Cgroup ID",
              "Value": "Giá trị",
              "alertname": "Cảnh báo",
              "severity": "Mức độ"
            }
          }
        }
      ]
    }
